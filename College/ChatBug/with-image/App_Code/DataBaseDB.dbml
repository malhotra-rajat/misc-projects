      <Column Name="Answer" Type="System.String" DbType="VarChar(50) NOT NULL" CanBeNull="false" />
      <Column Name="BDate" Type="System.Int32" DbType="Int NOT NULL" CanBeNull="false" />
      <Column Name="BMonth" Type="System.Int32" DbType="Int NOT NULL" CanBeNull="false" />
      <Column Name="Byear" Type="System.Int32" DbType="Int NOT NULL" CanBeNull="false" />
      <Column Name="CountryIndex" Type="System.Int32" DbType="Int NOT NULL" CanBeNull="false" />
